# main.py

import os
import inoutput  # inoutput.py 모듈 import

def main():
    # 1. tt.txt 파일 생성
    inoutput.generate_tt_txt()

    # 2. tt.txt 파일 경로 설정 (바탕화면 기준)
    desktop_path = os.path.join(os.path.expanduser('~'), 'Desktop')
    tt_txt_path = os.path.join(desktop_path, 'tt.txt')

    # 3. tt.txt 읽기
    if not os.path.exists(tt_txt_path):
        print("tt.txt 파일을 찾을 수 없습니다.")
        return

    ToDoWords = ['code:', '설명', '아래에 코드 작성']
    ToDoList = []

    with open(tt_txt_path, 'r', encoding='utf-8') as f:
        lines = f.readlines()

    # 4. ToDoWords가 포함된 줄 찾기
    for line in lines:
        if any(word in line for word in ToDoWords):
            ToDoList.append(line.strip())

    # 5. 결과 출력
    print(f"ToDoList (총 {len(ToDoList)}개 항목)")
    for idx, todo in enumerate(ToDoList, 1):
        print(f"{idx}: {todo}")

if __name__ == "__main__":
    main()
